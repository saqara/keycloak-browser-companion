{
  "manifest_version": 3,
  "name": "Saqara Browser Companion",
  "version": "1.2.1",
  "description": "Adds an \"Impersonate\" link to the Keycloak users table and suggests switching realms when appropriate. Also provides a bearer token copy button on AOS. Multi-browser and multi-environment extension.",
  "author": "Simon Rubuano <simon@rubuano.dev>",
  "host_permissions": [
    "https://*.saqara.com/*",
    "https://saqara.com/*",
    "https://*.go-aos.io/*",
    "https://go-aos.io/*",
    "http://keycloak:10000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.saqara.com/*",
        "https://saqara.com/*",
        "https://*.go-aos.io/*",
        "https://go-aos.io/*",
        "http://keycloak:10000/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "saqara-browser-companion@saqara",
      "strict_min_version": "109.0"
    }
  }
}
