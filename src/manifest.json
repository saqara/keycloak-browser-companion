{
  "manifest_version": 3,
  "name": "Saqara Keycloak Browser Companion",
  "version": "1.0.0",
  "description": "Ajoute un lien \"Impersonate\" dans le tableau des utilisateurs Keycloak et propose de basculer automatiquement vers le bon realm si besoin. Extension multi-navigateurs et multi-environnements.",
  "author": "Simon Rubuano <simon@rubuano.dev>",
  "host_permissions": [
    "https://account.demo.go-aos.io/*",
    "https://account.preproduction.saqara.com/*",
    "https://account.go-aos.io/*",
    "https://account.staging.saqara.com/*",
    "http://keycloak:10000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://account.demo.go-aos.io/*",
        "https://account.preproduction.saqara.com/*",
        "https://account.go-aos.io/*",
        "https://account.staging.saqara.com/*",
        "http://keycloak:10000/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "keycloak-browser-companion@saqara",
      "strict_min_version": "109.0"
    }
  }
}
